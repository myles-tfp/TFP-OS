# Supabase — set these in Netlify env vars and in .env.local for local dev
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — powers Rally. Server-side only; set in Netlify env vars (mark as secret).
ANTHROPIC_API_KEY=sk-ant-your-key

# Supabase — set these in Vercel env vars and in .env.local for local dev
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — powers Rally. Server-side only; set in Vercel env vars (mark as secret).
ANTHROPIC_API_KEY=sk-ant-your-key

# GIPHY — powers chat GIFs. Server-side only; set in Vercel env vars.
GIPHY_API_KEY=your-giphy-key
